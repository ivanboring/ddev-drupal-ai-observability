{
  "uid": "ai-latency-explorer",
  "title": "AI Latency & Explorer",
  "tags": [
    "ai",
    "latency",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## AI Latency & Request Explorer\nLatency distribution (span-metrics heatmap) and a live table of individual AI provider requests from Tempo."
      }
    },
    {
      "id": 1,
      "title": "Latency distribution over time",
      "type": "heatmap",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(traces_spanmetrics_latency_bucket{span_name=\"AI provider request\"}[$__rate_interval])) by (le)",
          "legendFormat": "{{le}}",
          "instant": false,
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "scheme": "Spectral",
          "mode": "scheme",
          "steps": 64
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "legend": {
          "show": true
        }
      }
    },
    {
      "id": 2,
      "title": "Avg latency by model (s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model)(rate(traces_spanmetrics_latency_sum{span_name=\"AI provider request\"}[$__rate_interval])) / sum by (model)(rate(traces_spanmetrics_latency_count{span_name=\"AI provider request\"}[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Recent AI requests (Tempo)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"AI provider request\" } | select(span.model, span.operation_type, span.\"gen_ai.usage.input_tokens\", span.\"gen_ai.usage.output_tokens\", span.\"agent.name\")",
          "tableType": "spans",
          "limit": 100,
          "spss": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "model": "Model",
              "operation_type": "Operation",
              "gen_ai.usage.input_tokens": "In tok",
              "gen_ai.usage.output_tokens": "Out tok",
              "agent.name": "Agent",
              "duration": "Duration",
              "time": "Time"
            },
            "excludeByName": {
              "traceIdHidden": true,
              "spanID": true,
              "traceName": true,
              "traceService": true,
              "name": true
            },
            "indexByName": {
              "time": 0,
              "model": 1,
              "operation_type": 2,
              "duration": 3,
              "gen_ai.usage.input_tokens": 4,
              "gen_ai.usage.output_tokens": 5,
              "agent.name": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Duration",
            "desc": true
          }
        ]
      }
    }
  ],
  "id": null
}