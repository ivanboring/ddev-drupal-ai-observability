          "expr": "sum(increase(traces_spanmetrics_latency_sum{span_name=\"AI provider request\"}[$__range]))/clamp_min(sum(increase(traces_spanmetrics_latency_count{span_name=\"AI provider request\"}[$__range])),1)",
