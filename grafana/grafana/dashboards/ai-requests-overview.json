  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## AI Requests \u2014 Overview (RED)\nRate \u00b7 Errors \u00b7 Duration for every AI provider request, derived from Tempo span-metrics. Pure request layer \u2014 independent of agents."
      }
    },
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"AI provider request\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Avg requests / min",
      "type": "stat",
      "gridPos": {
        "x": 4,
