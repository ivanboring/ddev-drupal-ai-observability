        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Token throughput (tokens/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(ai_token_usage_input_total[$__rate_interval]))",
          "legendFormat": "input",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(ai_token_usage_output_total[$__rate_interval]))",
          "legendFormat": "output",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Token split (type)",
      "type": "piechart",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (__name__)({__name__=~\"ai_token_usage_(input|output|reasoning|cached)_total\"})",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 12,
      "title": "Est. cost by model (USD)",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model)((sum by (provider,model)(ai_token_usage_input_total) * on(provider,model) group_left() last_over_time(ai_model_price_input_usd_per_mtok[7d])) + (sum by (provider,model)(ai_token_usage_output_total) * on(provider,model) group_left() last_over_time(ai_model_price_output_usd_per_mtok[7d]))) / 1e6",
          "legendFormat": "{{model}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      }
    },
    {
      "id": 13,
      "title": "Model prices \u2014 synced from models.dev (USD / 1M tokens)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "IN",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by(model)(last_over_time(ai_model_price_input_usd_per_mtok{provider=\"openai\"}[7d]) and on(model) group by(model)(last_over_time(ai_token_usage_input_total[7d])))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "OUT",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by(model)(last_over_time(ai_model_price_output_usd_per_mtok{provider=\"openai\"}[7d]) and on(model) group by(model)(last_over_time(ai_token_usage_input_total[7d])))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "CACHE",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by(model)(last_over_time(ai_model_price_cache_read_usd_per_mtok{provider=\"openai\"}[7d]) and on(model) group by(model)(last_over_time(ai_token_usage_input_total[7d])))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "model": "Model",
              "Value #IN": "Input $/Mtok",
              "Value #OUT": "Output $/Mtok",
              "Value #CACHE": "Cache read $/Mtok"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    }
  ],
  "id": null
}