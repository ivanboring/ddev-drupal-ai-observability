{
  "uid": "ai-tokens-cost",
  "title": "AI Tokens & Cost",
  "tags": [
    "ai",
    "tokens",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## AI Tokens & Cost\nToken throughput and **live-priced** spend across models. Token counts come from `ai_observability`; per-token prices are synced from [models.dev](https://models.dev) (`ai_model_price_*` gauges, refreshed by `ddev sync-model-prices`)."
      }
    },
    {
      "id": 1,
      "title": "Total tokens",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(ai_token_usage_total)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      }
    },
